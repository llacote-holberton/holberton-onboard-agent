# Files to ignore either because "contextual" to host, too sensitive...
#   Or just pointless to track XD.

# Application's running data
data

# Local environment variables (often contains secrets, API keys, etc.)
.env

# File setting Python environment used on local machine -> must not be tracked.
.python-version
# Local Python virtual environment
.venv/
env/

# Compiled Python bytecode
__pycache__
.pytest_cache

# Files temporarily generated by Kate when opened file with unsaved changes
*.kate-swp

