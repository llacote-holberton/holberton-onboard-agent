# HOW TO USE: please "save as" with filename '.env' in same folder
#   then adjust the values (after the =) as needed.

# Project name (will prefix all container names)
COMPOSE_PROJECT_NAME=hbn-onboarder

# = LLM model -- AGNOSTIQUE (2026-08-21) =
# Quel modèle planifie les actions d'onboarding -- UN SEUL identifiant,
# n'importe quel fournisseur, via LiteLLM (https://docs.litellm.ai) : voir
# agent/planner.py's module docstring (section LLM CONFIGURATION --
# AGNOSTIQUE) pour le detail complet. Format "<provider>/<model>", ex:
#   - anthropic/claude-sonnet-4-6 (DEFAUT, recommandé) : API Claude
#     distante. Nécessite LLM_MODEL_API_KEY ci-dessous. Nettement plus
#     fiable en tool-calling structuré en pratique que les petits modèles
#     locaux testés -- c'est ce qui a remplacé Ollama comme défaut après
#     des échecs répétés observés en conditions réelles (narration au
#     lieu d'appels d'outils, format perdu au-delà de ~5 tools...).
#   - ollama_chat/qwen3:8b (ou tout autre tag) : modèle local, aucune
#     donnée ne quitte votre machine, aucune clé nécessaire, mais
#     nettement moins fiable et demande un hôte capable (voir "Memory
#     management & Performance" dans README.md). Toujours pleinement
#     supporté pour usage hors-ligne / sans clé API -- ./start.sh détecte
#     automatiquement ce cas et démarre/prépare Ollama pour vous. IMPORTANT
#     : utilisez bien le préfixe "ollama_chat/", PAS "ollama/" -- LiteLLM
#     route "ollama/" vers l'API de complétion texte d'Ollama
#     (/api/generate), pas l'API chat (/api/chat) que le tool-calling
#     structuré nécessite en pratique -- voir agent/planner.py, section
#     OLLAMA de son docstring de module, pour le détail complet (y
#     compris un bug LiteLLM connu qui a pu faire disparaître les
#     tool_calls de qwen3 même via ollama_chat/ -- pensez à `pip install
#     --upgrade litellm` avant de dépanner un échec de génération d'actions
#     avec un modèle Ollama).
#   - openai/gpt-4o-mini, nvidia_nim/<org>/<modele>, gemini/..., et
#     globalement tout fournisseur supporté par LiteLLM : voir
#     https://docs.litellm.ai/docs/providers pour la liste complète et le
#     format exact du préfixe attendu par chacun.
LLM_MODEL_NAME=anthropic/claude-sonnet-4-6

# Clé API générique -- UNE SEULE variable à renseigner quel que soit le
# fournisseur choisi ci-dessus (voir agent/planner.py::
# _ensure_provider_api_key pour comment elle est reportée automatiquement
# sur la variable spécifique que LiteLLM attend réellement, ex:
# ANTHROPIC_API_KEY, OPENAI_API_KEY...). Laissez vide pour
# LLM_MODEL_NAME=ollama_chat/... ou ollama/... (aucune clé requise). Pour
# Anthropic (défaut ci-dessus) : obtenez une clé sur https://console.anthropic.com
# (Settings > API Keys) -- nécessite un compte avec facturation
# configurée ; ce projet ne fait qu'une poignée d'appels par plan généré,
# le coût reste donc faible en usage démo/dev, mais n'est PAS gratuit.
LLM_MODEL_API_KEY=

# = Ollama -- configuration du modèle local =
# Uniquement utile si LLM_MODEL_NAME ci-dessus commence par
# "ollama_chat/" (recommandé) ou "ollama/" (accepté, déconseillé pour le
# tool-calling -- voir juste au-dessus).
# IMPORTANT : le service `ollama` n'est plus démarré par `docker compose
# up` par défaut (voir docker-compose.yml) -- il faut aussi `--profile
# local-llm` (ou COMPOSE_PROFILES=local-llm ci-dessous) ET un
# téléchargement manuel du modèle la première fois. ./start.sh fait tout
# ça automatiquement (recommandé) -- sinon voir README.md "LLM Provider:
# any provider, any model" pour les étapes manuelles.
OLLAMA_HOST=ollama
OLLAMA_PORT=11434

# Décommentez pour démarrer le conteneur Ollama local par défaut sans
# avoir à passer --profile local-llm à chaque commande `docker compose`.
# Utile seulement si LLM_MODEL_NAME=ollama_chat/... ci-dessus (./start.sh le
# fait pour vous automatiquement, cette ligne est surtout utile si vous
# préférez lancer `docker compose` directement).
# COMPOSE_PROFILES=local-llm

# Timeout (seconds) for a SINGLE agent -> LLM call, during plan
# generation -- applies whichever provider is active (LLM_MODEL_NAME
# above). This is the innermost layer of a coordinated timeout chain
# (frontend -> backend -> agent -> LLM): backend and frontend read
# this SAME value and each add their own margin on top of it in code
# (+15s, +30s respectively -- see agent/planner.py::_LLM_CALL_TIMEOUT
# for the full rationale), so you only need to change this ONE number.
# Raise it if you're on a slower machine or a larger local model tag --
# e.g. a bigger qwen3 tag is noticeably slower per call than the
# default, especially on a cold start. Remote APIs are generally much
# faster per call, so the default margin is ample there.
LLM_CALL_TIMEOUT_SECONDS=110

# Anti-infinite-loop guard: maximum number of back-and-forth exchanges
# with the model for a SINGLE /plan request (exploration + action-building
# retries combined) -- see agent/planner.py::_MAX_TURNS for the full
# rationale. Once reached, the agent finalizes with whatever it has
# collected so far (plus an explicit notice if nothing was collected at
# all), rather than looping forever. Default (8) is sized for the 5
# functional tools this project ships with (5 actions + margin) -- raise
# it if you add more tools and the agent starts running out of turns
# before covering everything relevant. Note: raising this significantly
# also raises the theoretical worst-case duration of a single /plan call
# (MAX_TURNS x LLM_CALL_TIMEOUT_SECONDS above), which is currently NOT
# reflected in the backend/frontend timeout margins -- see the comment
# above _LLM_CALL_TIMEOUT in agent/planner.py.
MAX_TURNS=8

# = MCP Server configuration =
HBN_MCP_PORT=8200

# List of tools the LLM Agent can really *execute*, separated by comma.
# Any tool not listed here is still considered during planning and shown
# to the user, but struck through and excluded from execution.
# Current list: create_employee_record, send_welcome_message,
#   create_onboarding_issue, generate_handbook, create_calendar_event.
# IMPORTANT: leaving this EMPTY (the default below) means NO restriction
# at all -- every tool above is allowed, including sending real e-mails
# through MailHog. This is the most permissive setting, not the safest
# one. Set it explicitly (e.g. ALLOWED_TOOLS=create_employee_record,
# send_welcome_message) to actually restrict what gets executed.
ALLOWED_TOOLS=

# = Mailhog (fake SMTP + web UI, used by the mcp-server "mailbox" tool) =
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025
# Once running: open http://localhost:8025 to see emails the mailbox tool sent.

# = AI "Helper" Agent configuration =
AGENT_PORT=8100

# Backoffice configuration
BACKEND_PORT=8000

# Configuration for persistent data
DATA_DIR=/app/data
DATA_HOST_DIR=./data

# Frontend configuration
FRONTEND_PORT=8501

# GitHub configuration for issues -- ONLY required if you want to use the
# "create_onboarding_issue" tool (i.e. you include it in ALLOWED_TOOLS
# above, or just want the model to be able to propose it). Checked lazily,
# only when that tool actually runs, so the rest of the stack starts and
# works fine without them -- leave the placeholder below as-is if you
# don't need GitHub ticket creation. Only GitHub is supported for now.
GITHUB_TOKEN=<please-generate-your-token-following-instructions-from-the-provider>
GITHUB_REPO=llacote-holberton/holberton-onboard-agent

