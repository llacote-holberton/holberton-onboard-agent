# HOW TO USE: please "save as" with filename '.env' in same folder
#   then adjust the values (after the =) as needed.

# Project name (will prefix all container names)
COMPOSE_PROJECT_NAME=hbn-onboarder

# = Ollama Local model handler configuration =
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen3:8b

# = MCP Server configuration =
HBN_MCP_PORT=8200

# = AI "Helper" Agent configuration =
AGENT_PORT=8100

# Backoffice configuration
BACKEND_PORT=8000

# Keep this line if you want a local model (note: syntax is ollama/<modelname>)
LLM_MODEL_NAME=ollama/llama3.2:1b
# Uncomment and adjust these lines if you want to use a cloud / subscription based model requiring an API key
LLM_MODEL_NAME=nvidia_nim/minimaxai/minimax-m3
LLM_MODEL_API_KEY=<please-generate-your-key-following-instructions-from-the-provider>

# Configuration for persistent data
DATA_DIR=/app/data
DATA_HOST_DIR=./data
